{
  "name": "grandercommander",
  "productName": "GranderCommander",
  "version": "0.1.2",
  "description": "Total Commander for macOS",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:universal": "electron-vite build && electron-builder --mac --universal",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.grnd.grandercommander",
    "productName": "GranderCommander",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "GranderCommander needs access to your Desktop folder to display and manage its files.",
        "NSDocumentsFolderUsageDescription": "GranderCommander needs access to your Documents folder to display and manage its files.",
        "NSDownloadsFolderUsageDescription": "GranderCommander needs access to your Downloads folder to display and manage its files.",
        "NSRemovableVolumesUsageDescription": "GranderCommander needs access to removable volumes to display and manage their files.",
        "NSAppleEventsUsageDescription": "GranderCommander uses AppleEvents to open items and reveal them in Finder."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grnd",
        "repo": "grander-commander",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "GranderCommander ${version}",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-window": "^1.8.10",
    "zustand": "^4.5.0"
  }
}
