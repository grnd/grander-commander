<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 need writable-executable memory for JIT. Without these the
       app crashes on launch once the hardened runtime is enabled. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- node-pty ships a prebuilt .node binary that is not signed with our
       Developer ID. Library validation would refuse to load it, breaking the
       embedded terminal. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The embedded terminal spawns a login shell, and "Open With…" launches
       other applications via `open`. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>

  <!-- Reveal in Finder / Open With are AppleEvents to other apps. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
